---
interface Props {
  routeUrl: string;
  autoPlay?: boolean;
  openTabHref?: string;
  showOpenTab?: boolean;
  panelTitle?: string;
}

const {
  routeUrl,
  autoPlay = false,
  openTabHref = "",
  showOpenTab = true,
  panelTitle = "3D Route",
} = Astro.props;
---

<section
  class="flyby-panel"
  data-flyby-root
  data-route-url={routeUrl}
  data-auto-play={autoPlay ? "yes" : "no"}
>
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.2.0/dist/maplibre-gl.css" />

  <div class="flyby-head">
    <h2>{panelTitle}</h2>
    {showOpenTab && openTabHref && (
      <a class="flyby-tab-link" href={openTabHref} target="_blank" rel="noreferrer">
        Full screen ↗
      </a>
    )}
  </div>

  <div class="flyby-map-wrap">
    <div class="flyby-map" data-flyby-map></div>
    <div class="flyby-overlay" data-flyby-overlay>
      <button class="flyby-play-btn" data-flyby-play aria-label="Play route">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </button>
    </div>
  </div>

  <div class="flyby-elev-wrap">
    <canvas class="flyby-elev" data-flyby-elev height="64"></canvas>
    <div class="flyby-elev-cursor" data-flyby-cursor></div>
  </div>

  <div class="flyby-controls">
    <button class="flyby-ctrl-btn" data-flyby-play2 aria-label="Play/Pause">
      <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" style="display:none"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
    </button>
    <input class="flyby-scrub" type="range" min="0" max="1000" value="0" data-flyby-scrub />
    <select class="flyby-sel" data-flyby-speed aria-label="Speed">
      <option value="0.5">½×</option>
      <option value="1">1×</option>
      <option value="2" selected>2×</option>
      <option value="4">4×</option>
    </select>
    <select class="flyby-sel" data-flyby-preset aria-label="Camera">
      <option value="cinematic">Cinematic</option>
      <option value="balanced">Balanced</option>
      <option value="chase">Chase</option>
    </select>
  </div>
</section>

<script type="module">
  import maplibregl from "https://esm.sh/maplibre-gl@5.2.0";
  import {
    bearingDeg,
    buildPlaybackPoints,
    cameraPresets,
    clamp,
    haversineMeters,
    interpolatePointAtDistance,
    lerp,
    shortestAngleDiff,
    smoothPlaybackPoints,
  } from "../lib/flybyCore";

  const STRAVA_ORANGE = "#FC4C02";
  const GHOST_COLOR   = "rgba(255,255,255,0.35)";

  const buildStyle = () => ({
    version: 8,
    sources: {
      satellite: {
        type: "raster",
        tiles: ["https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"],
        tileSize: 256,
        maxzoom: 19,
        attribution: "Esri, DigitalGlobe, GeoEye, Earthstar Geographics",
      },
      terrain: {
        type: "raster-dem",
        tiles: ["https://elevation-tiles-prod.s3.amazonaws.com/terrarium/{z}/{x}/{y}.png"],
        tileSize: 256,
        encoding: "terrarium",
        maxzoom: 13,
      },
    },
    layers: [
      { id: "satellite", type: "raster", source: "satellite" },
      {
        id: "hillshade",
        type: "hillshade",
        source: "terrain",
        paint: {
          "hillshade-shadow-color": "#1a2030",
          "hillshade-highlight-color": "#aabbd0",
          "hillshade-exaggeration": 0.45,
        },
      },
    ],
    terrain: { source: "terrain", exaggeration: 1.5 },
  });

  const getCameraPreset = (id) => cameraPresets.find((p) => p.id === id) ?? cameraPresets[0];

  // ── Elevation profile canvas ────────────────────────────────────────────────

  function drawElevProfile(canvas, points, progress) {
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    canvas.width  = w * dpr;
    canvas.height = h * dpr;
    const ctx = canvas.getContext("2d");
    ctx.scale(dpr, dpr);

    const eles = points.map((p) => p.ele ?? 0);
    const minE = Math.min(...eles);
    const maxE = Math.max(...eles);
    const span = Math.max(maxE - minE, 1);
    const totalDist = points[points.length - 1].distanceFromStartM;
    const px = (i) => (points[i].distanceFromStartM / totalDist) * w;
    const py = (e) => h - ((e - minE) / span) * (h - 6) - 2;

    // Ghost path (full profile, dim)
    ctx.beginPath();
    ctx.moveTo(px(0), py(eles[0]));
    for (let i = 1; i < points.length; i++) ctx.lineTo(px(i), py(eles[i]));
    ctx.lineTo(px(points.length - 1), h);
    ctx.lineTo(px(0), h);
    ctx.closePath();
    ctx.fillStyle = "rgba(255,255,255,0.08)";
    ctx.fill();
    ctx.beginPath();
    ctx.moveTo(px(0), py(eles[0]));
    for (let i = 1; i < points.length; i++) ctx.lineTo(px(i), py(eles[i]));
    ctx.strokeStyle = "rgba(255,255,255,0.25)";
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // Active path (played portion, orange)
    const cutoff = Math.floor(progress * (points.length - 1));
    if (cutoff > 0) {
      ctx.beginPath();
      ctx.moveTo(px(0), py(eles[0]));
      for (let i = 1; i <= cutoff; i++) ctx.lineTo(px(i), py(eles[i]));
      ctx.lineTo(px(cutoff), h);
      ctx.lineTo(px(0), h);
      ctx.closePath();
      const grad = ctx.createLinearGradient(0, 0, 0, h);
      grad.addColorStop(0, "rgba(252,76,2,0.7)");
      grad.addColorStop(1, "rgba(252,76,2,0.15)");
      ctx.fillStyle = grad;
      ctx.fill();
      ctx.beginPath();
      ctx.moveTo(px(0), py(eles[0]));
      for (let i = 1; i <= cutoff; i++) ctx.lineTo(px(i), py(eles[i]));
      ctx.strokeStyle = STRAVA_ORANGE;
      ctx.lineWidth = 2;
      ctx.stroke();
    }
  }

  // ── Main ────────────────────────────────────────────────────────────────────

  let flybyCounter = 0;
  for (const root of document.querySelectorAll("[data-flyby-root]")) {
    if (root.dataset.flybyReady === "yes") continue;
    root.dataset.flybyReady = "yes";
    flybyCounter++;

    const routeUrl = root.dataset.routeUrl || "";
    if (!routeUrl) continue;

    const mapEl       = root.querySelector("[data-flyby-map]");
    const overlayEl   = root.querySelector("[data-flyby-overlay]");
    const playBtns    = root.querySelectorAll("[data-flyby-play],[data-flyby-play2]");
    const scrub       = root.querySelector("[data-flyby-scrub]");
    const speedSel    = root.querySelector("[data-flyby-speed]");
    const presetSel   = root.querySelector("[data-flyby-preset]");
    const elevCanvas  = root.querySelector("[data-flyby-elev]");
    const elevCursor  = root.querySelector("[data-flyby-cursor]");
    const autoPlay    = root.dataset.autoPlay === "yes";

    const srcGhost  = `flyby-ghost-${flybyCounter}`;
    const srcActive = `flyby-active-${flybyCounter}`;
    const lyrGhostC = `flyby-ghost-casing-${flybyCounter}`;
    const lyrGhost  = `flyby-ghost-line-${flybyCounter}`;
    const lyrActC   = `flyby-active-casing-${flybyCounter}`;
    const lyrAct    = `flyby-active-line-${flybyCounter}`;

    let playbackPoints = [];
    let playState = "idle";
    let progress  = 0;
    let speed     = 2;
    let presetId  = "cinematic";
    let rafId     = null;
    let lastTs    = null;
    let lastBearing = null;
    let camState    = null;
    let lastCamTs   = 0;
    let lastRouteTs = 0;

    const map = new maplibregl.Map({
      container: mapEl,
      style: buildStyle(),
      center: [-2.6, 54.4],
      zoom: 5.5,
      pitch: 70,
      bearing: -20,
      maxPitch: 85,
    });
    map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), "top-right");

    const emptyFC = { type: "FeatureCollection", features: [] };

    const ensureLayers = () => {
      if (!map.isStyleLoaded()) return;
      for (const id of [lyrGhostC, lyrGhost, lyrActC, lyrAct]) {
        if (map.getLayer(id)) map.removeLayer(id);
      }
      for (const id of [srcGhost, srcActive]) {
        if (map.getSource(id)) map.removeSource(id);
      }
      map.addSource(srcGhost,  { type: "geojson", data: emptyFC });
      map.addSource(srcActive, { type: "geojson", data: emptyFC });

      map.addLayer({ id: lyrGhostC, type: "line", source: srcGhost,
        paint: { "line-color": "#000", "line-width": 5, "line-opacity": 0.4 },
        layout: { "line-cap": "round", "line-join": "round" } });
      map.addLayer({ id: lyrGhost, type: "line", source: srcGhost,
        paint: { "line-color": GHOST_COLOR, "line-width": 2.5, "line-opacity": 1 },
        layout: { "line-cap": "round", "line-join": "round" } });

      map.addLayer({ id: lyrActC, type: "line", source: srcActive,
        paint: { "line-color": "#7a2000", "line-width": 9, "line-opacity": 0.7 },
        layout: { "line-cap": "round", "line-join": "round" } });
      map.addLayer({ id: lyrAct, type: "line", source: srcActive,
        paint: { "line-color": STRAVA_ORANGE, "line-width": 5, "line-opacity": 1 },
        layout: { "line-cap": "round", "line-join": "round" } });
    };

    const setGhost = (coords) => {
      const src = map.getSource(srcGhost);
      if (!src) return;
      src.setData(coords.length < 2 ? emptyFC : {
        type: "FeatureCollection",
        features: [{ type: "Feature", properties: {}, geometry: { type: "LineString", coordinates: coords } }],
      });
    };

    const setActive = (coords) => {
      const src = map.getSource(srcActive);
      if (!src) return;
      src.setData(coords.length < 2 ? emptyFC : {
        type: "FeatureCollection",
        features: [{ type: "Feature", properties: {}, geometry: { type: "LineString", coordinates: coords } }],
      });
    };

    const drawActive = (nowMs = performance.now()) => {
      if (!playbackPoints.length) return;
      if (nowMs - lastRouteTs < 33) return;
      lastRouteTs = nowMs;
      const total = playbackPoints[playbackPoints.length - 1].distanceFromStartM;
      const reveal = clamp(progress, 0, 1) * total;
      const coords = [];
      for (let i = 0; i < playbackPoints.length; i++) {
        const pt = playbackPoints[i];
        if (pt.distanceFromStartM <= reveal) { coords.push([pt.lon, pt.lat]); continue; }
        if (i > 0) {
          const prev = playbackPoints[i - 1];
          const span = Math.max(pt.distanceFromStartM - prev.distanceFromStartM, 1e-4);
          const t = clamp((reveal - prev.distanceFromStartM) / span, 0, 1);
          coords.push([lerp(prev.lon, pt.lon, t), lerp(prev.lat, pt.lat, t)]);
        }
        break;
      }
      setActive(coords);
    };

    const updateCamera = (val, nowMs = performance.now(), force = false) => {
      if (!playbackPoints.length) return;
      if (!force && nowMs - lastCamTs < 16) return;
      lastCamTs = nowMs;
      const preset = getCameraPreset(presetId);
      const total = playbackPoints[playbackPoints.length - 1].distanceFromStartM;
      const targetDist = clamp(val, 0, 1) * total;
      const cur     = interpolatePointAtDistance(playbackPoints, targetDist);
      const look    = interpolatePointAtDistance(playbackPoints, targetDist + preset.lookaheadMeters);
      const behind  = interpolatePointAtDistance(playbackPoints, targetDist - preset.chaseMeters);
      const lookDist = haversineMeters(cur.lat, cur.lon, look.lat, look.lon);
      const rawBearing = lookDist < 5 && lastBearing !== null
        ? lastBearing
        : bearingDeg(cur.lat, cur.lon, look.lat, look.lon);
      const smoothBearing = (() => {
        if (lastBearing === null) return rawBearing;
        const desired = (lastBearing + shortestAngleDiff(lastBearing, rawBearing) * preset.bearingSmoothing + 360) % 360;
        const step = clamp(shortestAngleDiff(lastBearing, desired), -2.5, 2.5);
        return (lastBearing + step + 360) % 360;
      })();
      lastBearing = smoothBearing;
      const zoom = clamp(preset.zoomBase, preset.zoomMin, preset.zoomMax);
      const desLon = lerp(cur.lon, behind.lon, 0.74);
      const desLat = lerp(cur.lat, behind.lat, 0.74);
      const follow = playState === "playing" ? 0.14 : 0.28;
      const cam = camState ? {
        lon:     lerp(camState.lon, desLon, follow),
        lat:     lerp(camState.lat, desLat, follow),
        zoom:    lerp(camState.zoom, zoom, follow),
        bearing: (camState.bearing + shortestAngleDiff(camState.bearing, smoothBearing) * follow + 360) % 360,
        pitch:   lerp(camState.pitch, preset.pitch, follow),
      } : { lon: desLon, lat: desLat, zoom, bearing: smoothBearing, pitch: preset.pitch };
      camState = cam;
      map.jumpTo({ center: [cam.lon, cam.lat], bearing: cam.bearing, pitch: cam.pitch, zoom: cam.zoom });
      drawActive(nowMs);
    };

    const updateElev = () => {
      if (!elevCanvas || !elevCursor || !playbackPoints.length) return;
      drawElevProfile(elevCanvas, playbackPoints, progress);
      const pct = progress * 100;
      elevCursor.style.left = `${pct}%`;
    };

    const setPlayIcons = (playing) => {
      for (const btn of playBtns) {
        const p = btn.querySelector(".icon-play");
        const pa = btn.querySelector(".icon-pause");
        if (p)  p.style.display  = playing ? "none" : "";
        if (pa) pa.style.display = playing ? "" : "none";
      }
    };

    const stopPlayback = () => {
      if (rafId !== null) cancelAnimationFrame(rafId);
      rafId = null; lastTs = null;
    };

    const tick = (ts) => {
      if (lastTs === null) lastTs = ts;
      const delta = ts - lastTs;
      lastTs = ts;
      const total = Math.max(playbackPoints[playbackPoints.length - 1].distanceFromStartM, 1);
      const baseDur = clamp(total * 6, 25000, 150000);
      progress = clamp(progress + delta / (baseDur / speed), 0, 1);
      scrub.value = String(Math.round(progress * 1000));
      updateCamera(progress, ts);
      updateElev();
      if (progress >= 1) {
        playState = "paused";
        setPlayIcons(false);
        stopPlayback();
        return;
      }
      rafId = requestAnimationFrame(tick);
    };

    const startPlayback = () => {
      if (!playbackPoints.length) return;
      if (progress >= 1) { progress = 0; scrub.value = "0"; lastBearing = null; camState = null; }
      overlayEl?.remove();
      playState = "playing";
      setPlayIcons(true);
      if (rafId === null) rafId = requestAnimationFrame(tick);
    };

    const pausePlayback = () => {
      playState = "paused";
      setPlayIcons(false);
      stopPlayback();
    };

    for (const btn of playBtns) {
      btn.addEventListener("click", () => {
        if (playState === "playing") pausePlayback();
        else startPlayback();
      });
    }

    scrub.addEventListener("input", () => {
      progress = Number(scrub.value) / 1000;
      updateCamera(progress, performance.now(), true);
      drawActive();
      updateElev();
    });
    speedSel.addEventListener("change", () => { speed = Number(speedSel.value) || 2; });
    presetSel.addEventListener("change", () => {
      presetId = presetSel.value;
      lastBearing = null; camState = null;
      updateCamera(progress, performance.now(), true);
    });

    // ── Scrub by clicking elevation profile ─────────────────────────────────
    elevCanvas?.addEventListener("click", (e) => {
      const rect = elevCanvas.getBoundingClientRect();
      progress = clamp((e.clientX - rect.left) / rect.width, 0, 1);
      scrub.value = String(Math.round(progress * 1000));
      updateCamera(progress, performance.now(), true);
      drawActive();
      updateElev();
    });

    map.on("load", () => { ensureLayers(); });
    map.on("styledata", () => { ensureLayers(); drawActive(performance.now()); });

    // ── Load route JSON ──────────────────────────────────────────────────────
    fetch(routeUrl)
      .then((r) => { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then((data) => {
        // data.coords = [[lon, lat, ele], ...]
        let cum = 0;
        const rawPoints = data.coords.map(([lon, lat, ele], i) => {
          if (i > 0) {
            const [plon, plat] = data.coords[i - 1];
            cum += haversineMeters(plat, plon, lat, lon);
          }
          return { lat, lon, ele: ele ?? 0, distanceFromStartM: cum };
        });

        const sampled = buildPlaybackPoints(rawPoints, 1800);
        playbackPoints = smoothPlaybackPoints(sampled, 2);

        // Show full ghost route immediately
        const allCoords = playbackPoints.map((p) => [p.lon, p.lat]);
        const trySetGhost = () => {
          if (map.getSource(srcGhost)) { setGhost(allCoords); return; }
          map.once("idle", () => setGhost(allCoords));
        };
        trySetGhost();

        // Fit map to route
        const bounds = new maplibregl.LngLatBounds(
          [playbackPoints[0].lon, playbackPoints[0].lat],
          [playbackPoints[0].lon, playbackPoints[0].lat]
        );
        for (const p of playbackPoints) bounds.extend([p.lon, p.lat]);
        map.fitBounds(bounds, { padding: 48, maxZoom: 14, duration: 800, pitch: 70, bearing: -20 });

        updateCamera(0, performance.now(), true);
        updateElev();
        window.addEventListener("resize", updateElev);

        if (autoPlay) startPlayback();
      })
      .catch(() => {});
  }
</script>

<style>
  .flyby-panel {
    background: #0d1117;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .flyby-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1rem 0.7rem;
    gap: 0.75rem;
  }

  .flyby-head h2 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: #e0d8d0;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .flyby-tab-link {
    font-size: 0.78rem;
    color: #FC4C02;
    text-decoration: none;
    white-space: nowrap;
  }
  .flyby-tab-link:hover { text-decoration: underline; }

  .flyby-map-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #0d1117;
  }

  .flyby-map {
    position: absolute;
    inset: 0;
  }

  .flyby-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(0,0,0,0.38);
    z-index: 10;
    cursor: pointer;
  }

  .flyby-play-btn {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: none;
    background: rgba(252,76,2,0.9);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: transform 0.15s, background 0.15s;
    box-shadow: 0 4px 20px rgba(252,76,2,0.5);
  }
  .flyby-play-btn:hover { transform: scale(1.08); background: #FC4C02; }
  .flyby-play-btn svg { width: 32px; height: 32px; margin-left: 3px; }

  .flyby-elev-wrap {
    position: relative;
    height: 64px;
    background: #0d1117;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .flyby-elev {
    width: 100%;
    height: 100%;
    display: block;
    cursor: pointer;
  }

  .flyby-elev-cursor {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #FC4C02;
    transform: translateX(-50%);
    pointer-events: none;
    box-shadow: 0 0 6px rgba(252,76,2,0.8);
  }

  .flyby-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.75rem;
    background: #0d1117;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .flyby-ctrl-btn {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 6px;
    background: rgba(252,76,2,0.15);
    color: #FC4C02;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background 0.15s;
  }
  .flyby-ctrl-btn:hover { background: rgba(252,76,2,0.3); }
  .flyby-ctrl-btn svg { width: 18px; height: 18px; }

  .flyby-scrub {
    flex: 1;
    min-width: 0;
    accent-color: #FC4C02;
    height: 4px;
    cursor: pointer;
  }

  .flyby-sel {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 6px;
    color: #c8bfb5;
    font-size: 0.75rem;
    padding: 0.3rem 0.45rem;
    cursor: pointer;
  }
  .flyby-sel:focus { outline: 1px solid #FC4C02; }

  /* MapLibre overrides for dark panel */
  .flyby-map .maplibregl-canvas { display: block; }
  .flyby-map .maplibregl-ctrl-group {
    background: rgba(13,17,23,0.85) !important;
    border: 1px solid rgba(255,255,255,0.1) !important;
  }
  .flyby-map .maplibregl-ctrl button {
    background-color: transparent !important;
    color: #c8bfb5 !important;
  }

  @media (max-width: 500px) {
    .flyby-sel:last-child { display: none; }
  }
</style>

---
/**
 * A quiet bar: the brand and the four links that matter. No tagline, and no
 * Blog or Gallery until they hold something worth linking to.
 */
interface Props {
  siteName: string;
  regions: string[];
}

const { siteName, regions } = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <div class="brand-name">{siteName}</div>
    </a>

    <nav class="nav" aria-label="Main navigation">
      <a href="/walks/">Walks</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <div class="dropdown">
        <button type="button" aria-haspopup="true">Regions</button>
        <div class="dropdown-content">
          {regions.map((region) => (
            <a href={`/walks/?region=${encodeURIComponent(region)}`}>{region}</a>
          ))}
        </div>
      </div>
    </nav>
  </div>
</header>



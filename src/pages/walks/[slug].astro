---
import "leaflet/dist/leaflet.css";
import { existsSync } from "fs";
import { join } from "path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FlybyPanel from "../../components/FlybyPanel.astro";
import DogChecklist from "../../components/DogChecklist.astro";
import StartPanel from "../../components/StartPanel.astro";
import NearbyWalks from "../../components/NearbyWalks.astro";
import { getNearbyWalks, getPublishedWalks, getRegions, getSiteSettings } from "../../lib/content";
import { imgSrc } from "../../lib/imgSrc";

export async function getStaticPaths() {
  const walks = await getPublishedWalks();
  return walks.map((walk) => ({
    params: { slug: walk.slug },
    props: { walk },
  }));
}

const { walk } = Astro.props;
const settings = await getSiteSettings();
const regions = await getRegions();
const { Content } = await walk.render();
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const encodedUrl = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(walk.data.title);
const mapApiKey = import.meta.env.PUBLIC_OS_MAPS_API_KEY ?? "";
const gpxUrl = walk.data.gpxDownload ?? "";
const hasGpx = Boolean(gpxUrl);
const walkDateStr = (walk.data.walkDate ?? walk.data.publishDate).toISOString().slice(0, 10);
const routeFilePath = join(process.cwd(), "public", "routes", `${walkDateStr}.json`);
const hasRoute = existsSync(routeFilePath);
const routeUrl = hasRoute ? `/routes/${walkDateStr}.json` : "";
// Photo pins are optional: the map fetches this and quietly skips a 404.
const photosUrl = walkDateStr ? `/photos/${walkDateStr}.json` : "";
const nearby = await getNearbyWalks(walk, 4);
const estimatedHours = walk.data.difficulty === "Hard"
  ? Math.max(3, Math.round(walk.data.distance / 2))
  : walk.data.difficulty === "Moderate"
    ? Math.max(2, Math.round(walk.data.distance / 2.4))
    : Math.max(1, Math.round(walk.data.distance / 2.8));
---

<BaseLayout
  title={`${walk.data.title} | ${settings.siteName}`}
  description={walk.data.summary}
  regions={regions}
  siteName={settings.siteName}
  tagline={settings.tagline}
>
  <div class="container page-grid">
    <article class="card article">
      <img src={imgSrc(walk.data.heroImage)} alt={walk.data.title} />
      <h1>{walk.data.title}</h1>
      <p class="article-meta">
        {walk.data.location} · {walk.data.region} · {walk.data.distance} mi · {walk.data.difficulty} ·
        {walk.data.dogFriendly ? " Dog-friendly" : " Not dog-friendly"}
      </p>
      <p>{walk.data.summary}</p>

      <ul class="chip-list">
        {walk.data.tags.map((tag) => <li class="chip">{tag}</li>)}
      </ul>

      <section class="route-facts">
        <div>
          <span>Distance</span>
          <strong>
            {walk.data.routeDistance
              ? `${walk.data.routeDistance} mi`
              : `${walk.data.distance} mi`}
          </strong>
          {walk.data.routeDistance && (
            <small class="fact-note">{walk.data.distance} mi walked</small>
          )}
        </div>
        {walk.data.ascentM && <div><span>Ascent</span><strong>{walk.data.ascentM} m</strong></div>}
        <div><span>Difficulty</span><strong>{walk.data.difficulty}</strong></div>
        <div><span>Estimated Time</span><strong>{estimatedHours} hrs</strong></div>
        <div><span>Dog Access</span><strong>{walk.data.dogFriendly ? "Dog-friendly" : "Lead only / restricted areas"}</strong></div>
      </section>

      <StartPanel
        gridRef={walk.data.startGridRef}
        postcode={walk.data.startPostcode}
        parking={walk.data.parking}
        lat={walk.data.routeMapLat}
        lng={walk.data.routeMapLng}
        stiles={walk.data.stiles}
        refreshments={walk.data.refreshments}
        toilets={walk.data.toilets}
      />

      <section class="card strava-stats" id="strava-stats" data-date={walkDateStr}>
        <div class="strava-inner">
          <span class="strava-loading">Loading Strava data…</span>
        </div>
      </section>

      <section class:list={["map-compare", hasRoute && "two-panels"]}>
        <section class="card map-card">
          <div class="flyby-head">
            <h2>Route Map</h2>
            <a
              class="button ghost-dark"
              href={walk.data.osMapsLink ?? walk.data.gpxDownload}
              target="_blank"
              rel="noreferrer"
            >
              Open In New Tab
            </a>
          </div>
          <div
            class="map-panel"
            id="map"
            data-lat={String(walk.data.routeMapLat)}
            data-lng={String(walk.data.routeMapLng)}
            data-zoom={String(walk.data.routeMapZoom)}
            data-map-api-key={mapApiKey}
            data-gpx-url={gpxUrl}
            data-photos-url={photosUrl}
          ></div>
          <div id="route-debug-log" hidden style="margin-top:0.65rem;max-height:140px;overflow:auto;white-space:pre-wrap;padding:0.55rem 0.65rem;border:1px solid #dcc6ac;border-radius:10px;background:#fff6e9;color:#5d4431;font-size:0.78rem;"></div>
        </section>
        {hasRoute && (
          <FlybyPanel
            routeUrl={routeUrl}
            autoPlay={false}
            openTabHref={`/flyby/${walk.slug}/?autoplay=1`}
            showOpenTab={true}
            panelTitle="3D Route"
          />
        )}
      </section>
      <section class="card planning-strip">
        <div>
          <h2>Map and navigation</h2>
          <p>
            The line on the map is the GPX from the day, so it is the route as
            actually walked. You will not find numbered directions telling you to
            bear left at the third gate.
          </p>
          <p class="muted">
            That is on purpose. This is not about telling you where to go. It is
            about sharing a route that works with a dog, and getting you out to
            explore it yourself.
          </p>
        </div>
        <div class="planning-links">
          {walk.data.osMapsLink && <a class="button" href={walk.data.osMapsLink} target="_blank" rel="noreferrer">Open OS Maps Route</a>}
          <a class="button ghost-dark" href={walk.data.gpxDownload} target="_blank" rel="noreferrer">Download GPX</a>
        </div>
      </section>

      <DogChecklist
        accessLand={walk.data.accessLand}
        livestock={walk.data.livestock}
        stiles={walk.data.stiles}
        water={walk.data.water}
        roads={walk.data.roads}
        terrain={walk.data.terrain}
        offLead={walk.data.offLead}
        walkDate={walk.data.walkDate ?? walk.data.publishDate}
      />

      <section class="card">
        <h2>Route Notes</h2>
        {walk.data.writeupStatus === "draft" && (
          <p class="writeup-notice">
            <strong>Proposed write-up.</strong> Drafted from the GPS track and the
            photographs. The weather, the company and the reasons are still missing.
          </p>
        )}
        <Content />
      </section>

      <section class="card wwe-photos" id="wwe-photos" data-date={walkDateStr}>
        <h2>Photos from this walk</h2>
        <div class="wwe-grid" id="wwe-grid"></div>
      </section>

      <section class="card">
        <h2>Downloads and Links</h2>
        <p><strong>Mountain weather:</strong> <a href="https://www.mwis.org.uk/" target="_blank" rel="noreferrer">MWIS forecast</a></p>
        <p><strong>General weather:</strong> <a href="https://www.metoffice.gov.uk/" target="_blank" rel="noreferrer">Met Office</a></p>
        <p><a href={walk.data.gpxDownload} target="_blank" rel="noreferrer">Download GPX</a></p>
      </section>

      <NearbyWalks nearby={nearby} />

      <section class="card">
        <h2>Share This Walk</h2>
        <div class="share-row">
          <a class="button" href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} target="_blank" rel="noreferrer">Facebook</a>
          <a class="button" href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`} target="_blank" rel="noreferrer">X</a>
          <a class="button" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`} target="_blank" rel="noreferrer">LinkedIn</a>
          <a class="button" href={`mailto:?subject=${encodedTitle}&body=${encodedUrl}`}>Email</a>
        </div>
      </section>
    </article>
  </div>

  <script type="application/ld+json" is:inline define:vars={{ walk: walk.data, pageUrl }}>
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TouristTrip",
      name: walk.title,
      description: walk.summary,
      url: pageUrl,
      touristType: "Walkers"
    })}
  </script>

  <script>
    import L from "leaflet";

    const mapContainer = document.getElementById("map");
    const routeDebugEl = document.getElementById("route-debug-log");

    const lat = Number(mapContainer?.dataset.lat || "0");
    const lng = Number(mapContainer?.dataset.lng || "0");
    const zoom = Number(mapContainer?.dataset.zoom || "11");
    const mapApiKey = mapContainer?.dataset.mapApiKey || "";
    const gpxUrl = mapContainer?.dataset.gpxUrl || "";

    function logDebug(message) {
      const ts = new Date().toLocaleTimeString("en-GB", { hour12: false });
      const line = `[${ts}] ${message}`;
      console.log(line);
      if (routeDebugEl) {
        const previous = (routeDebugEl.textContent || "").trim();
        routeDebugEl.textContent = `${line}\n${previous}`.split("\n").slice(0, 28).join("\n");
      }
    }

    function showMapMessage(message) {
      if (!mapContainer) return;
      mapContainer.innerHTML = `<div style="display:grid;place-items:center;height:100%;padding:1rem;color:#7c6654;font-size:0.95rem;">${message}</div>`;
      logDebug(`UI message: ${message}`);
    }

    function extractTrackPoints(xmlText) {
      const doc = new DOMParser().parseFromString(xmlText, "application/xml");
      const points = [];
      const trk = Array.from(doc.querySelectorAll("trkpt"));
      const rte = Array.from(doc.querySelectorAll("rtept"));
      const nodes = trk.length > 0 ? trk : rte;
      for (const node of nodes) {
        const pLat = Number(node.getAttribute("lat"));
        const pLng = Number(node.getAttribute("lon"));
        if (Number.isFinite(pLat) && Number.isFinite(pLng)) points.push([pLat, pLng]);
      }
      return points;
    }

    logDebug(`Start lat=${lat} lng=${lng} zoom=${zoom} apiKey=${mapApiKey ? "yes" : "no"}`);
    logDebug(`GPX URL: ${gpxUrl || "(empty)"}`);

    if (!mapContainer) {
      logDebug("No #map container found.");
    } else {
      try {
        const map = L.map(mapContainer).setView([lat, lng], zoom);
        logDebug("Leaflet map initialized.");

        if (mapApiKey) {
          L.tileLayer("https://api.os.uk/maps/raster/v1/zxy/Outdoor_3857/{z}/{x}/{y}.png?key={accessToken}", {
            accessToken: mapApiKey,
            maxZoom: 18,
            attribution: "&copy; Ordnance Survey"
          }).addTo(map);
          logDebug("OS tile layer attached.");
        } else {
          L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 18,
            attribution: "&copy; OpenStreetMap contributors"
          }).addTo(map);
          logDebug("OSM tile layer attached (no API key).");
        }

        const dropFallbackMarker = () => {
          L.circleMarker([lat, lng], { radius: 5, color: "#be6d37", weight: 2, fillOpacity: 1 }).addTo(map);
          logDebug("Fallback marker rendered.");
        };

        const drawRouteFromGpx = async () => {
          if (!gpxUrl) {
            logDebug("No GPX URL available.");
            dropFallbackMarker();
            return;
          }

          try {
            logDebug(`Fetching GPX: ${gpxUrl}`);
            const response = await fetch(gpxUrl);
            logDebug(`GPX fetch status=${response.status}`);
            if (!response.ok) throw new Error(`HTTP ${response.status}`);

            const gpxXml = await response.text();
            logDebug(`GPX size=${gpxXml.length} chars`);

            const routePoints = extractTrackPoints(gpxXml);
            logDebug(`Extracted route points=${routePoints.length}`);

            if (routePoints.length < 2) {
              logDebug("Too few GPX points; using fallback marker.");
              dropFallbackMarker();
              return;
            }

            const routeLine = L.polyline(routePoints, { color: "#be6d37", weight: 4, opacity: 0.9 }).addTo(map);
            map.fitBounds(routeLine.getBounds(), { padding: [24, 24] });
            L.circleMarker(routePoints[0], { radius: 5, color: "#1f7a1f", weight: 2, fillOpacity: 1 }).addTo(map);
            L.circleMarker(routePoints[routePoints.length - 1], { radius: 5, color: "#9e2a2a", weight: 2, fillOpacity: 1 }).addTo(map);
            logDebug("Route rendered successfully.");

            await dropPhotoPins(map, L);
          } catch (error) {
            logDebug(`GPX render error: ${error?.message || error}`);
            dropFallbackMarker();
          }
        };

        drawRouteFromGpx();
      } catch (error) {
        logDebug(`Map init error: ${error?.message || error}`);
        showMapMessage("Map failed to load on this page.");
      }

      /**
       * Pins each photo on the map at the spot it was taken.
       * Photos matched on time alone carry no trustworthy position, so they
       * are excluded here (they still appear in the gallery below the map).
       */
      async function dropPhotoPins(map, L) {
        const photosUrl = mapContainer.dataset.photosUrl;
        if (!photosUrl) return;

        let data;
        try {
          const res = await fetch(photosUrl);
          if (!res.ok) return; // no photo set for this walk yet
          data = await res.json();
        } catch {
          return;
        }

        const pinnable = (data.photos || []).filter(
          (p) => p.pinnable && typeof p.lat === "number" && typeof p.lon === "number",
        );
        if (!pinnable.length) return;

        const group = L.layerGroup().addTo(map);
        pinnable.forEach((photo, i) => {
          const km = (photo.metresAlongRoute ?? 0) / 1000;
          const time = new Date(photo.time).toLocaleTimeString("en-GB", {
            hour: "2-digit",
            minute: "2-digit",
          });

          // Colour by subject so the map reads at a glance: views, Ember, people.
          const subject = photo.subject ?? "scenery";
          const marker = L.marker([photo.lat, photo.lon], {
            icon: L.divIcon({
              className: `route-photo-pin is-${subject}`,
              html: `<span>${i + 1}</span>`,
              iconSize: [22, 22],
              iconAnchor: [11, 11],
            }),
            alt: `${subject} photo ${i + 1}, taken at ${time}, ${km.toFixed(1)}km into the walk`,
            keyboard: true,
          }).addTo(group);

          marker.on("click", () => openLightbox(i));
          marker.on("keypress", (e) => {
            if (e.originalEvent?.key === "Enter") openLightbox(i);
          });
        });


        // Open the photo full-size rather than inside the map panel — a
        // Leaflet popup is capped by the map's own bounds, so a 1600px
        // photograph was being shown at thumbnail size in the corner.
        function openLightbox(index) {
          const box = document.createElement("div");
          box.className = "photo-lightbox";
          box.innerHTML = `
            <button class="photo-lightbox-close" aria-label="Close">&times;</button>
            <button class="photo-lightbox-nav prev" aria-label="Previous photo">&#8249;</button>
            <figure>
              <img alt="" />
              <figcaption></figcaption>
            </figure>
            <button class="photo-lightbox-nav next" aria-label="Next photo">&#8250;</button>`;
          document.body.appendChild(box);
          document.body.style.overflow = "hidden";

          let i = index;
          const img = box.querySelector("img");
          const cap = box.querySelector("figcaption");

          const show = (n) => {
            i = (n + pinnable.length) % pinnable.length;
            const photo = pinnable[i];
            const km = (photo.metresAlongRoute ?? 0) / 1000;
            const time = new Date(photo.time).toLocaleTimeString("en-GB", {
              hour: "2-digit", minute: "2-digit",
            });
            img.src = photo.src;
            img.alt = `Taken at ${time}, ${km.toFixed(1)}km into the walk`;
            cap.textContent = `${i + 1} of ${pinnable.length} · ${time} · ${km.toFixed(1)}km in`;
          };

          const close = () => {
            box.remove();
            document.body.style.overflow = "";
            document.removeEventListener("keydown", onKey);
          };

          function onKey(e) {
            if (e.key === "Escape") close();
            else if (e.key === "ArrowLeft") show(i - 1);
            else if (e.key === "ArrowRight") show(i + 1);
          }

          box.querySelector(".photo-lightbox-close").addEventListener("click", close);
          box.querySelector(".prev").addEventListener("click", (e) => { e.stopPropagation(); show(i - 1); });
          box.querySelector(".next").addEventListener("click", (e) => { e.stopPropagation(); show(i + 1); });
          // Clicking the backdrop closes; clicking the photo itself should not.
          box.addEventListener("click", (e) => { if (e.target === box) close(); });
          document.addEventListener("keydown", onKey);

          show(index);
        }


        // A legend, but only for the subjects actually present on this walk.
        const present = [...new Set(pinnable.map((p) => p.subject ?? "scenery"))];
        if (present.length > 1) {
          const labels = { scenery: "View", dog: "Ember", people: "People" };
          const legend = L.control({ position: "bottomleft" });
          legend.onAdd = () => {
            const el = L.DomUtil.create("div", "route-photo-legend");
            el.innerHTML = present
              .map((s) => `<span class="is-${s}"><i></i>${labels[s] ?? s}</span>`)
              .join("");
            return el;
          };
          legend.addTo(map);
        }
        logDebug(`Photo pins rendered: ${pinnable.length}`);
      }
    }
  </script>
  <script>
    // Strava stats
    const stravaSection = document.getElementById('strava-stats') as HTMLElement | null;
    const stravaDate    = stravaSection?.dataset.date;

    if (stravaDate && stravaSection) {
      fetch(`/api/strava?date=${stravaDate}`)
        .then(r => r.json())
        .then(({ activity }: { activity: any }) => {
          if (!activity) { stravaSection.hidden = true; return; }

          const fmt = (v: string | number | null, unit: string) =>
            v != null ? `<strong>${v}</strong><span>${unit}</span>` : '';

          const hrs  = activity.moving_time_min ? Math.floor(activity.moving_time_min / 60) : null;
          const mins = activity.moving_time_min ? activity.moving_time_min % 60 : null;
          const time = hrs != null
            ? `<strong>${hrs}h ${String(mins).padStart(2,'0')}m</strong><span>time</span>`
            : '';

          stravaSection.innerHTML = `
            <div class="strava-head">
              <span class="strava-name">${activity.name}</span>
              ${activity.strava_url ? `<a href="${activity.strava_url}" class="strava-link" target="_blank" rel="noreferrer">View on Strava →</a>` : ''}
            </div>
            <div class="strava-grid">
              ${fmt(activity.distance_miles, 'miles')}
              ${fmt(activity.elevation_ft ? activity.elevation_ft.toLocaleString() : null, 'ft gain')}
              ${time}
              ${fmt(activity.avg_hr, 'avg bpm')}
              ${fmt(activity.calories, 'kcal')}
            </div>`;
        })
        .catch(() => { if (stravaSection) stravaSection.hidden = true; });
    } else if (stravaSection) {
      stravaSection.hidden = true;
    }
  </script>

  <script>
    const wweSection = document.getElementById('wwe-photos') as HTMLElement | null;
    const wweGrid    = document.getElementById('wwe-grid');
    const wweDate    = (wweSection as HTMLElement | null)?.dataset.date;

    if (wweDate && wweSection && wweGrid) {
      fetch(`https://upload.nickward.co.uk/api/gallery/wwe?date=${wweDate}`)
        .then(r => r.json())
        .then(({ images }: { images: any[] }) => {
          if (!images?.length) { wweSection.hidden = true; return; }
          wweGrid.innerHTML = images.map(img => {
            const thumb = img.image_url.replace('/upload/', '/upload/w_600,c_limit,q_auto/');
            const alt   = img.caption || img.location_name || 'Walk photo';
            return `<a href="${img.image_url}" target="_blank" rel="noreferrer" class="wwe-thumb">
              <img src="${thumb}" alt="${alt}" loading="lazy" />
            </a>`;
          }).join('');
        })
        .catch(() => { if (wweSection) wweSection.hidden = true; });
    } else if (wweSection) {
      wweSection.hidden = true;
    }
  </script>

  <style>
    /* Strava */
    .strava-stats[hidden] { display: none; }
    .strava-loading { color: #b0a090; font-size: 0.85rem; }
    .strava-head {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }
    .strava-logo { width: 1.4rem; height: 1.4rem; flex-shrink: 0; }
    .strava-name { font-weight: 600; font-size: 1rem; flex: 1; min-width: 0; }
    .strava-link {
      font-size: 0.75rem;
      color: #FC4C02;
      text-decoration: none;
      white-space: nowrap;
    }
    .strava-link:hover { text-decoration: underline; }
    .strava-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 1.25rem 2rem;
    }
    .strava-grid strong {
      display: block;
      font-size: 1.4rem;
      font-weight: 700;
      line-height: 1;
      color: #2a1f16;
    }
    .strava-grid span {
      display: block;
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #9a8070;
      margin-top: 0.2rem;
    }

    /* WWE photos */
    .wwe-photos[hidden] { display: none; }
    .wwe-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 0.5rem;
      margin-top: 1rem;
    }
    .wwe-thumb img {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      display: block;
      border-radius: 4px;
      transition: opacity 0.2s;
    }
    .wwe-thumb:hover img { opacity: 0.85; }
  </style>
</BaseLayout>


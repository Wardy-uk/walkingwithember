---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getRegions, getSiteSettings } from "../lib/content";

const settings = await getSiteSettings();
const regions = await getRegions();
const page = (await getCollection("pages")).find((entry) => entry.slug === "about");
const { Content } = page ? await page.render() : { Content: null };

const people = page?.data.people ?? [];

/**
 * The numbers are counted from the walks at build time rather than typed in.
 * A figure that has to be remembered is a figure that goes stale, and an About
 * page still claiming 437 miles two years from now does the opposite of
 * building trust.
 */
const walks = await getCollection("walks");
const totalMiles = walks.reduce((sum, w) => sum + (w.data.routeDistance ?? w.data.distance ?? 0), 0);
const totalAscent = walks.reduce((sum, w) => sum + (w.data.ascentM ?? 0), 0);

const walkDates = walks
  .map((w) => w.data.walkDate ?? w.data.publishDate)
  .filter(Boolean)
  .map((d) => new Date(d as Date))
  .sort((a, b) => a.getTime() - b.getTime());
const firstYear = walkDates.length ? walkDates[0].getFullYear() : new Date().getFullYear();

// Everest is the unit people actually feel. 8,848m.
const everests = totalAscent / 8848;

const stats = [
  { value: walks.length.toString(), label: "routes recorded" },
  { value: Math.round(totalMiles).toLocaleString("en-GB"), label: "miles walked" },
  { value: `${Math.round(totalAscent).toLocaleString("en-GB")}m`, label: `of ascent, ${everests.toFixed(1)} × Everest` },
  { value: `since ${firstYear}`, label: "and still going" },
];

const siteUrl = "https://walkingwithember.co.uk";

/**
 * Person and AboutPage markup. Search engines lean on this to work out who is
 * behind advice, which matters more than usual here: this site tells people
 * where it is safe to take a dog.
 */
const schema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: page?.data.title ?? "About",
  url: `${siteUrl}/about/`,
  description: page?.data.seoDescription,
  mainEntity: {
    "@type": "Person",
    name: "Nick Ward",
    description: `Hillwalker documenting ${walks.length} dog-tested walking routes across the Peak District, Charnwood and beyond.`,
    knowsAbout: ["Hillwalking", "Dog-friendly walking routes", "Peak District", "Charnwood Forest", "Countryside access"],
    image: people[0]?.image ? `${siteUrl}${people[0].image}` : undefined,
    url: `${siteUrl}/about/`,
  },
  publisher: { "@type": "Organization", name: settings.siteName, url: siteUrl },
};
---

<BaseLayout
  title={`${settings.siteName} | About`}
  description={page?.data.seoDescription ?? "About this walking and outdoors website."}
  regions={regions}
  siteName={settings.siteName}
  tagline={settings.tagline}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="container page-grid">
    {people.map((person, i) => (
      <section class={`about-person${i % 2 === 1 ? " is-flipped" : ""}`}>
        <div class="about-person-photo">
          <img
            src={person.image}
            alt={person.alt}
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : undefined}
          />
        </div>
        <div class="about-person-text">
          {i === 0 ? <h1>{person.heading}</h1> : <h2>{person.heading}</h2>}
          {person.body
            .split(/\n\s*\n/)
            .map((para) => para.trim())
            .filter(Boolean)
            .map((para) => <p>{para}</p>)}
        </div>
      </section>
    ))}

    <section class="about-stats" aria-label="What is on this site">
      {stats.map((s) => (
        <div class="about-stat">
          <strong>{s.value}</strong>
          <span>{s.label}</span>
        </div>
      ))}
    </section>

    <section class="card about-body">
      {Content ? <Content /> : <p>This page is managed through the CMS.</p>}
    </section>

    <section class="about-cta card">
      <h2>Start with the walks</h2>
      <p>Every route carries the GPX, the grid reference and the dog detail.</p>
      <div class="about-cta-links">
        <a class="button" href="/walks/">Browse the routes</a>
        <a class="button ghost-dark" href="/contact/">Tell me I am wrong</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-person {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(1.2rem, 4vw, 3rem);
    align-items: center;
    margin: clamp(1.5rem, 5vw, 3.5rem) 0;
  }
  /* Alternate the photo side so three stacked introductions do not read as a list. */
  .about-person.is-flipped .about-person-photo {
    order: 2;
  }

  .about-person-photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 12px;
    display: block;
  }

  .about-person-text h1,
  .about-person-text h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    line-height: 1.1;
  }
  .about-person-text p {
    margin: 0 0 0.85rem;
  }
  .about-person-text p:last-child {
    margin-bottom: 0;
  }

  .about-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 2rem 0 0;
  }
  .about-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1.1rem 1rem;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.035);
  }
  .about-stat strong {
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1;
  }
  .about-stat span {
    font-size: 0.82rem;
    opacity: 0.75;
  }

  .about-body :global(h2) {
    margin-top: 2rem;
  }
  .about-body :global(h2:first-child) {
    margin-top: 0;
  }

  .about-cta-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.9rem;
  }

  @media (prefers-color-scheme: dark) {
    .about-stat {
      background: rgba(255, 255, 255, 0.06);
    }
  }

  @media (max-width: 860px) {
    .about-person {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    /* Photo always first on a phone, whatever the desktop order says. */
    .about-person.is-flipped .about-person-photo {
      order: 0;
    }
    .about-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

---
export const prerender = true;
const PHOTO_BASE = 'https://upload.nickward.co.uk';
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700&family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Manrope:wght@400;500;700&display=swap" rel="stylesheet" />
  <title>Site Settings · Walking with Ember</title>
  <style is:global>
    :root { --bg:#F5F0E8; --surface:#FDFAF6; --text:#1C1510; --muted:#8A7A6A; --line:rgba(28,21,16,0.13); --brand:#C65D1E; --brand-deep:#9A4515; --ok:#3f7a3f; --err:#8a2020; }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:"Manrope","Segoe UI",Arial,sans-serif; font-size:.95rem; color:var(--text); background:var(--bg); min-height:100vh; }
    .wrap { width:min(860px,calc(100% - 2rem)); margin:1.2rem auto 3rem; display:grid; gap:.9rem; }
    .topbar { display:flex; align-items:center; justify-content:space-between; gap:.6rem; flex-wrap:wrap; }
    .page-title { font-family:"Fraunces",Georgia,serif; font-size:1.3rem; }
    .card { background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:1.1rem 1.2rem; }
    .card h2 { font-family:"Fraunces",Georgia,serif; font-size:1.1rem; margin-bottom:.7rem; }
    .card h3 { font-family:"Fraunces",Georgia,serif; font-size:.95rem; color:var(--brand-deep); margin:1rem 0 .5rem; }
    .card h3:first-child { margin-top:0; }
    .btn { border:0; border-radius:999px; padding:.58rem 1rem; background:var(--brand); color:#FFF8F2; text-decoration:none; cursor:pointer; font:700 .82rem "Manrope",sans-serif; letter-spacing:.06em; transition:background .15s; display:inline-block; }
    .btn:hover { background:var(--brand-deep); }
    .btn:disabled { opacity:.45; cursor:not-allowed; }
    .btn.ghost { background:var(--bg); border:1px solid var(--line); color:var(--text); }
    .btn.ghost:hover { background:#EDE8DE; }
    .btn.big { padding:.72rem 1.6rem; font-size:1rem; }
    .btn.pick { background:var(--bg); border:1px solid var(--line); color:var(--brand-deep); font-size:.76rem; padding:.38rem .75rem; flex-shrink:0; }
    .btn.pick:hover { background:#EDE8DE; }
    .field { display:grid; gap:.3rem; }
    label { font-weight:700; font-size:.84rem; color:var(--muted); }
    label .opt { font-weight:400; }
    input[type="text"], input[type="url"], input[type="password"] { width:100%; border:1px solid var(--line); border-radius:10px; padding:.56rem .7rem; font:inherit; font-size:.93rem; color:var(--text); background:var(--surface); transition:border-color .15s; }
    input:focus { outline:none; border-color:var(--brand); }
    .grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:.7rem; }

    /* ── Image field with pick button ── */
    .img-field { display:flex; gap:.4rem; align-items:center; }
    .img-field input { flex:1; min-width:0; }
    .img-preview { width:64px; height:48px; object-fit:cover; border-radius:8px; border:1px solid var(--line); flex-shrink:0; background:var(--bg); }

    /* ── Gallery list ── */
    .img-list { display:grid; gap:.5rem; }
    .img-row { display:flex; gap:.4rem; align-items:center; }
    .img-row input { flex:1; min-width:0; }
    .img-row .del-btn { flex-shrink:0; width:28px; height:28px; border-radius:50%; background:#fde8e8; border:1px solid #e8b3b3; color:#8a2020; font-size:1rem; line-height:1; cursor:pointer; display:flex; align-items:center; justify-content:center; }
    .img-row-preview { width:44px; height:36px; object-fit:cover; border-radius:6px; border:1px solid var(--line); flex-shrink:0; background:var(--bg); }

    /* ── Status ── */
    .status-msg { padding:.7rem .9rem; border-radius:10px; font-weight:700; font-size:.9rem; display:none; margin-top:.8rem; }
    .status-msg.show { display:block; }
    .status-msg.ok   { background:#d9f0d9; color:var(--ok); border:1px solid #b3d9b3; }
    .status-msg.err  { background:#fde8e8; color:var(--err); border:1px solid #e8b3b3; }
    .status-msg.info { background:#f0e8d9; color:#7a5a30; border:1px solid var(--line); }
    .spin { display:inline-block; width:1em; height:1em; border:2px solid currentColor; border-right-color:transparent; border-radius:50%; animation:spin .7s linear infinite; vertical-align:middle; }
    @keyframes spin { to { transform:rotate(360deg); } }
    .save-row { display:flex; gap:.7rem; align-items:flex-end; flex-wrap:wrap; }
    .save-row .field { flex:1; min-width:160px; }

    /* ── Photo picker modal ── */
    .picker-backdrop {
      position:fixed; inset:0; z-index:50;
      background:rgba(28,21,16,0.55);
      backdrop-filter:blur(4px);
      display:none; align-items:flex-start; justify-content:center;
      padding:3vh 1rem;
    }
    .picker-backdrop.open { display:flex; }
    .picker-modal {
      background:var(--surface); border-radius:18px;
      width:min(900px,100%); max-height:90vh;
      display:flex; flex-direction:column;
      box-shadow:0 24px 60px rgba(28,21,16,0.3);
      overflow:hidden;
    }
    .picker-head {
      display:flex; align-items:center; justify-content:space-between; gap:.6rem;
      padding:.8rem 1rem; border-bottom:1px solid var(--line); flex-shrink:0;
    }
    .picker-head h3 { font-family:"Fraunces",Georgia,serif; font-size:1rem; margin:0; }
    .picker-close { background:none; border:none; font-size:1.4rem; line-height:1; cursor:pointer; color:var(--muted); padding:.2rem .4rem; }
    .picker-close:hover { color:var(--text); }
    .picker-filters {
      display:flex; gap:.5rem; padding:.6rem 1rem; border-bottom:1px solid var(--line); flex-shrink:0; flex-wrap:wrap;
    }
    .picker-filters input {
      border:1px solid var(--line); border-radius:999px; padding:.35rem .7rem;
      font:inherit; font-size:.8rem; background:var(--surface); color:var(--text);
    }
    .picker-filters input[type="search"] { flex:1; min-width:160px; }
    .picker-filters input:focus { outline:none; border-color:var(--brand); }
    .picker-body { overflow-y:auto; padding:.75rem; flex:1; }
    .picker-grid {
      display:grid;
      grid-template-columns:repeat(auto-fill, minmax(100px, 1fr));
      gap:4px;
    }
    .picker-thumb {
      border-radius:4px; overflow:hidden; cursor:pointer; position:relative;
      border:2px solid transparent; transition:border-color .15s;
      background:var(--bg); aspect-ratio:1;
    }
    .picker-thumb:hover { border-color:var(--brand); }
    .picker-thumb img { width:100%; height:100%; object-fit:cover; display:block; }
    .picker-thumb-meta {
      position:absolute; inset:auto 0 0 0; padding:.25rem .3rem;
      background:linear-gradient(to top,rgba(28,21,16,.75) 0%,transparent 100%);
      font-size:.62rem; color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
      opacity:0; transition:opacity .15s;
    }
    .picker-thumb:hover .picker-thumb-meta { opacity:1; }
    .picker-status { padding:1rem; color:var(--muted); font-size:.88rem; }

    @media (max-width:640px) { .grid-2 { grid-template-columns:1fr; } }
  </style>
</head>
<body>
<div class="wrap">
  <div class="topbar">
    <div style="display:flex;gap:.4rem;">
      <a class="btn ghost" href="/admin/dashboard/">← Dashboard</a>
      <a class="btn ghost" href="/" target="_blank" rel="noreferrer">View site</a>
    </div>
    <span class="page-title">Site Settings</span>
  </div>

  <section class="card" id="loadCard">
    <h2>Load current settings</h2>
    <div class="save-row">
      <div class="field">
        <label for="passwordInput">Admin password</label>
        <input type="password" id="passwordInput" placeholder="Enter password…" />
      </div>
      <button class="btn big" id="loadBtn" type="button">Load settings</button>
    </div>
    <div class="status-msg" id="loadStatus"></div>
  </section>

  <div id="settingsForm" style="display:none;">
    <div style="display:grid;gap:.9rem;">

      <section class="card">
        <h2>Site Info</h2>
        <div class="grid-2" style="margin-bottom:.7rem;">
          <div class="field">
            <label for="siteName">Site name</label>
            <input type="text" id="siteName" />
          </div>
          <div class="field">
            <label for="tagline">Tagline</label>
            <input type="text" id="tagline" />
          </div>
        </div>
        <div class="grid-2">
          <div class="field">
            <label for="instagram">Instagram URL <span class="opt">(optional)</span></label>
            <input type="url" id="instagram" placeholder="https://instagram.com/…" />
          </div>
          <div class="field">
            <label for="facebook">Facebook URL <span class="opt">(optional)</span></label>
            <input type="url" id="facebook" placeholder="https://facebook.com/…" />
          </div>
        </div>
      </section>

      <section class="card">
        <h2>Homepage Images</h2>

        <h3>Masthead / hero image</h3>
        <div class="img-field" style="margin-bottom:.6rem;">
          <img id="mastheadPreview" class="img-preview" src="" alt="" style="display:none;" />
          <input type="url" id="mastheadUrl" placeholder="https://res.cloudinary.com/…" />
          <button class="btn pick" type="button" data-picker="masthead">Pick photo</button>
        </div>

        <h3>Homepage gallery photos</h3>
        <p style="color:var(--muted);font-size:.82rem;margin-bottom:.6rem;">These appear in the "Nick and Ember" section. Two images work best.</p>
        <div class="img-list" id="galleryList"></div>
        <button class="btn ghost" id="addGalleryImg" type="button" style="margin-top:.5rem;font-size:.82rem;">+ Add image</button>
      </section>

      <section class="card">
        <div style="display:flex;gap:.7rem;align-items:center;flex-wrap:wrap;">
          <button class="btn big" id="saveBtn" type="button">Save settings</button>
        </div>
        <div class="status-msg" id="saveStatus"></div>
      </section>

    </div>
  </div>
</div>

<!-- ── Photo picker modal ── -->
<div class="picker-backdrop" id="pickerBackdrop">
  <div class="picker-modal">
    <div class="picker-head">
      <h3>Pick a photo from upload.nickward.co.uk</h3>
      <button class="picker-close" id="pickerClose" type="button" aria-label="Close">×</button>
    </div>
    <div class="picker-filters">
      <input type="search" id="pickerSearch" placeholder="Search location…" />
      <input type="date"   id="pickerDate" />
    </div>
    <div class="picker-body">
      <div class="picker-status" id="pickerStatus">Loading photos…</div>
      <div class="picker-grid" id="pickerGrid"></div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ PHOTO_BASE }}>
(function () {
  let fileSha     = null;
  let allPhotos   = [];
  let pickerTarget = null; // 'masthead' | HTMLElement (gallery row input)

  const $ = id => document.getElementById(id);

  const passwordInput   = $('passwordInput');
  const savePassword    = passwordInput; // same field reused
  const loadBtn         = $('loadBtn');
  const saveBtn         = $('saveBtn');
  const loadStatus      = $('loadStatus');
  const saveStatus      = $('saveStatus');
  const settingsForm    = $('settingsForm');
  const mastheadUrl     = $('mastheadUrl');
  const mastheadPreview = $('mastheadPreview');
  const galleryList     = $('galleryList');
  const pickerBackdrop  = $('pickerBackdrop');
  const pickerGrid      = $('pickerGrid');
  const pickerStatus    = $('pickerStatus');
  const pickerSearch    = $('pickerSearch');
  const pickerDate      = $('pickerDate');

  // ── Masthead preview ──
  mastheadUrl.addEventListener('input', () => {
    const url = mastheadUrl.value.trim();
    mastheadPreview.src = url;
    mastheadPreview.style.display = url ? 'block' : 'none';
  });

  // ── Load settings ──
  async function doLoad(pw) {
    loadBtn.disabled = true;
    loadBtn.innerHTML = '<span class="spin"></span> Loading…';
    showMsg(loadStatus, 'Fetching from GitHub…', 'info');
    try {
      const res  = await fetch(`/api/read-content?path=src/content/settings/site.json&password=${encodeURIComponent(pw)}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
      const settings = JSON.parse(data.content);
      fileSha = data.sha;
      sessionStorage.setItem('wwe_admin_pw', pw);
      $('siteName').value  = settings.siteName || '';
      $('tagline').value   = settings.tagline  || '';
      $('instagram').value = settings.social?.instagram || '';
      $('facebook').value  = settings.social?.facebook  || '';
      mastheadUrl.value    = settings.homepage?.mastheadImage || '';
      mastheadUrl.dispatchEvent(new Event('input'));
      renderGallery(settings.homepage?.galleryImages || []);
      settingsForm.style.display = 'block';
      hideMsg(loadStatus);
      loadPhotos(); // pre-load picker in background
    } catch (err) {
      sessionStorage.removeItem('wwe_admin_pw');
      showMsg(loadStatus, 'Error: ' + err.message, 'err');
    } finally {
      loadBtn.disabled = false;
      loadBtn.textContent = 'Reload';
    }
  }

  loadBtn.addEventListener('click', async () => {
    const pw = passwordInput.value;
    if (!pw) { showMsg(loadStatus, 'Enter password first.', 'err'); return; }
    await doLoad(pw);
  });

  // ── Auto-load if password is cached ──
  const cached = sessionStorage.getItem('wwe_admin_pw');
  if (cached) { passwordInput.value = cached; doLoad(cached); }

  // ── Gallery list ──
  function renderGallery(images) {
    galleryList.innerHTML = '';
    images.forEach(url => addGalleryRow(url));
  }

  function addGalleryRow(url = '') {
    const row = document.createElement('div');
    row.className = 'img-row';

    const preview = document.createElement('img');
    preview.className = 'img-row-preview';
    preview.src = url ? cloudThumb(url, 88, 66) : '';
    preview.alt = '';

    const input = document.createElement('input');
    input.type = 'url';
    input.value = url;
    input.placeholder = 'https://res.cloudinary.com/…';
    input.addEventListener('input', () => { preview.src = cloudThumb(input.value.trim(), 88, 66); });

    const pick = document.createElement('button');
    pick.className = 'btn pick';
    pick.type = 'button';
    pick.textContent = 'Pick';
    pick.addEventListener('click', () => openPicker(input));

    const del = document.createElement('button');
    del.className = 'del-btn';
    del.type = 'button';
    del.innerHTML = '×';
    del.addEventListener('click', () => row.remove());

    row.append(preview, input, pick, del);
    galleryList.appendChild(row);
    return row;
  }

  $('addGalleryImg').addEventListener('click', () => {
    const row = addGalleryRow();
    row.querySelector('input').focus();
  });

  // ── Pick button on masthead ──
  document.querySelector('[data-picker="masthead"]').addEventListener('click', () => openPicker('masthead'));

  // ── Photo picker ──
  async function loadPhotos() {
    if (allPhotos.length) return; // already loaded
    pickerStatus.textContent = 'Loading photos…';
    try {
      const res  = await fetch(`${PHOTO_BASE}/api/gallery`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      allPhotos  = (Array.isArray(data) ? data : (data.images || []))
        .sort((a, b) => (b.taken_at || '').localeCompare(a.taken_at || ''));
      pickerStatus.textContent = '';
    } catch (err) {
      pickerStatus.textContent = 'Could not load photos: ' + err.message;
    }
  }

  function openPicker(target) {
    pickerTarget = target;
    pickerSearch.value = '';
    pickerDate.value   = '';
    pickerBackdrop.classList.add('open');
    document.body.style.overflow = 'hidden';
    renderPickerGrid(allPhotos);
    if (!allPhotos.length) loadPhotos().then(() => renderPickerGrid(allPhotos));
  }

  function closePicker() {
    pickerBackdrop.classList.remove('open');
    document.body.style.overflow = '';
    pickerTarget = null;
  }

  $('pickerClose').addEventListener('click', closePicker);
  pickerBackdrop.addEventListener('click', e => { if (e.target === pickerBackdrop) closePicker(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePicker(); });

  pickerSearch.addEventListener('input', filterPicker);
  pickerDate.addEventListener('input', filterPicker);

  function filterPicker() {
    const q    = pickerSearch.value.trim().toLowerCase();
    const date = pickerDate.value.trim();
    const filtered = allPhotos.filter(p => {
      if (date && !(p.taken_at || '').startsWith(date)) return false;
      if (q && !`${p.location_name || ''} ${p.caption || ''}`.toLowerCase().includes(q)) return false;
      return true;
    });
    renderPickerGrid(filtered);
  }

  function renderPickerGrid(photos) {
    pickerGrid.innerHTML = '';
    if (!photos.length) {
      pickerStatus.textContent = allPhotos.length ? 'No photos match.' : 'Loading…';
      return;
    }
    pickerStatus.textContent = '';
    photos.forEach(photo => {
      const div = document.createElement('div');
      div.className = 'picker-thumb';
      const thumb = cloudThumb(photo.image_url, 200, 200);
      const loc   = photo.location_name || photo.caption || '';
      const date  = (photo.taken_at || '').slice(0, 10);
      div.innerHTML = `<img src="${thumb}" loading="lazy" alt="${loc}" /><div class="picker-thumb-meta">${loc || date}</div>`;
      div.addEventListener('click', () => {
        selectPhoto(photo.image_url);
        closePicker();
      });
      pickerGrid.appendChild(div);
    });
  }

  function selectPhoto(url) {
    if (pickerTarget === 'masthead') {
      mastheadUrl.value = url;
      mastheadUrl.dispatchEvent(new Event('input'));
    } else if (pickerTarget instanceof HTMLElement) {
      pickerTarget.value = url;
      pickerTarget.dispatchEvent(new Event('input'));
    }
  }

  // ── Save settings ──
  saveBtn.addEventListener('click', async () => {
    const pw = savePassword.value;
    if (!pw) { showMsg(saveStatus, 'Enter password.', 'err'); return; }
    if (!fileSha) { showMsg(saveStatus, 'Load settings first.', 'err'); return; }
    const galleryImages = Array.from(galleryList.querySelectorAll('input[type="url"]'))
      .map(i => i.value.trim()).filter(Boolean);
    const settings = {
      siteName: $('siteName').value.trim(),
      tagline:  $('tagline').value.trim(),
      baseUrl:  'https://www.walkingwithember.co.uk',
      social: { instagram: $('instagram').value.trim(), facebook: $('facebook').value.trim() },
      homepage: { mastheadImage: mastheadUrl.value.trim(), galleryImages },
    };
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<span class="spin"></span> Saving…';
    showMsg(saveStatus, 'Committing to GitHub…', 'info');
    try {
      const res = await fetch('/api/save-content', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          password: pw,
          path:    'src/content/settings/site.json',
          content: JSON.stringify(settings, null, 2) + '\n',
          message: 'Update site settings',
          sha:     fileSha,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
      showMsg(saveStatus, '✓ Settings saved! Site rebuilding — live in ~2 minutes.', 'ok');
      fileSha = null;
    } catch (err) {
      showMsg(saveStatus, 'Error: ' + err.message, 'err');
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save settings';
    }
  });

  // ── Helpers ──
  function cloudThumb(url, w, h) {
    if (!url || !url.includes('cloudinary.com')) return url;
    return url.replace('/upload/', `/upload/w_${w},h_${h},c_fill,q_70/`);
  }

  function showMsg(el, text, type) { el.textContent = text; el.className = `status-msg show ${type}`; }
  function hideMsg(el) { el.className = 'status-msg'; el.textContent = ''; }
})();
</script>
</body>
</html>

---
export const prerender = true;
const PHOTO_BASE = 'https://upload.nickward.co.uk';
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700&family=Fraunces:opsz,wght@9..144,400&family=Manrope:wght@400;600;700&display=swap" rel="stylesheet" />
  <title>Photo Library · Walking with Ember</title>
  <style>
    :root {
      --bg:#F5F0E8; --surface:#FDFAF6; --text:#1C1510; --muted:#8A7A6A;
      --line:rgba(28,21,16,0.13); --brand:#C65D1E; --brand-deep:#9A4515;
    }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:"Manrope","Segoe UI",sans-serif; font-size:.9rem; color:var(--text); background:var(--bg); min-height:100vh; }
    .wrap { width:min(1200px,calc(100% - 2rem)); margin:1.2rem auto 3rem; display:grid; gap:.8rem; }
    .topbar { display:flex; align-items:center; justify-content:space-between; gap:.6rem; flex-wrap:wrap; }
    .page-title { font-family:"Fraunces",Georgia,serif; font-size:1.3rem; }
    .card { background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:1rem 1.2rem; }
    .btn { border:0; border-radius:999px; padding:.58rem 1rem; background:var(--brand); color:#FFF8F2; text-decoration:none; cursor:pointer; font:700 .82rem "Manrope",sans-serif; letter-spacing:.06em; transition:background .15s; display:inline-block; }
    .btn:hover { background:var(--brand-deep); }
    .btn.ghost { background:var(--bg); border:1px solid var(--line); color:var(--text); }
    .btn.ghost:hover { background:#EDE8DE; }

    /* Filters */
    .filters { display:flex; gap:.6rem; flex-wrap:wrap; align-items:center; }
    .filters input, .filters select {
      border:1px solid var(--line); border-radius:999px; padding:.42rem .85rem;
      font:inherit; font-size:.82rem; background:var(--surface); color:var(--text);
    }
    .filters input:focus, .filters select:focus { outline:none; border-color:var(--brand); }
    .filters input[type="search"] { min-width:220px; }

    /* Grid */
    .photo-grid {
      display:grid;
      grid-template-columns:repeat(auto-fill, minmax(140px, 1fr));
      gap:.5rem;
    }
    .photo-card {
      border:1px solid var(--line);
      border-radius:8px;
      overflow:hidden;
      background:var(--surface);
      cursor:pointer;
      transition:transform .2s, box-shadow .2s;
      position:relative;
    }
    .photo-card:hover { transform:translateY(-2px); box-shadow:0 8px 20px rgba(28,21,16,0.12); }
    .photo-card.copied { border-color:var(--brand); }
    .photo-card img { width:100%; height:110px; object-fit:cover; display:block; }
    .photo-meta { padding:.5rem .65rem; }
    .photo-meta .loc { font-size:.74rem; font-weight:600; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .photo-meta .date { font-size:.7rem; color:var(--muted); opacity:.7; margin-top:.1rem; }
    .copy-badge {
      position:absolute; top:.4rem; right:.4rem;
      background:var(--brand); color:#fff;
      font-size:.68rem; font-weight:700; letter-spacing:.06em;
      padding:.2rem .5rem; border-radius:999px;
      opacity:0; pointer-events:none; transition:opacity .2s;
    }
    .photo-card.copied .copy-badge { opacity:1; }

    /* States */
    .status { padding:.9rem 1.1rem; border-radius:10px; font-weight:600; font-size:.88rem; }
    .status.loading { background:#f0e8d9; color:#7a5a30; border:1px solid var(--line); }
    .status.error   { background:#fde8e8; color:#7a2323; border:1px solid #e8b3b3; }
    .status.empty   { background:var(--surface); color:var(--muted); border:1px solid var(--line); }

    .count { font-size:.78rem; color:var(--muted); }
    .spin { display:inline-block; width:.9em; height:.9em; border:2px solid currentColor; border-right-color:transparent; border-radius:50%; animation:spin .7s linear infinite; vertical-align:middle; margin-right:.35em; }
    @keyframes spin { to { transform:rotate(360deg); } }

    /* Toast */
    .toast {
      position:fixed; bottom:1.5rem; left:50%; transform:translateX(-50%) translateY(4px);
      background:var(--text); color:var(--bg); padding:.55rem 1.1rem; border-radius:999px;
      font-size:.82rem; font-weight:700; opacity:0; pointer-events:none;
      transition:opacity .2s, transform .2s; z-index:99;
    }
    .toast.show { opacity:1; transform:translateX(-50%) translateY(0); }
  </style>
</head>
<body>
<div class="wrap">
  <div class="topbar">
    <div style="display:flex;gap:.4rem;">
      <a class="btn ghost" href="/admin/dashboard/">← Dashboard</a>
    </div>
    <span class="page-title">Photo Library</span>
    <a class="btn ghost" href="https://upload.nickward.co.uk" target="_blank" rel="noreferrer">Open upload.nickward.co.uk ↗</a>
  </div>

  <section class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.6rem;margin-bottom:.8rem;">
      <div class="filters">
        <input type="search" id="searchInput" placeholder="Search location or caption…" />
        <input type="date"   id="dateInput" />
        <button class="btn ghost" id="clearBtn" type="button">Clear</button>
      </div>
      <span class="count" id="countLabel"></span>
    </div>
    <div id="statusEl"></div>
    <div id="photoGrid" class="photo-grid"></div>
  </section>

  <section class="card" style="font-size:.82rem;color:var(--muted);">
    <strong style="color:var(--text);">How to use</strong> — Click any photo to copy its URL to the clipboard. Paste it into the <strong>hero image</strong> field in the walk builder or site settings.
  </section>
</div>

<div class="toast" id="toast">URL copied</div>

<script is:inline define:vars={{ PHOTO_BASE }}>
(function () {
  const photoGrid   = document.getElementById('photoGrid');
  const statusEl    = document.getElementById('statusEl');
  const countLabel  = document.getElementById('countLabel');
  const searchInput = document.getElementById('searchInput');
  const dateInput   = document.getElementById('dateInput');
  const clearBtn    = document.getElementById('clearBtn');
  const toast       = document.getElementById('toast');

  let allPhotos = [];
  let toastTimer = null;

  function showStatus(html, type) {
    statusEl.innerHTML = `<div class="status ${type}">${html}</div>`;
  }

  function clearStatus() { statusEl.innerHTML = ''; }

  function showToast(msg) {
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), 2200);
  }

  function cloudinaryThumb(url) {
    if (!url || !url.includes('cloudinary.com')) return url;
    return url.replace('/upload/', '/upload/w_240,h_180,c_fill,q_60/');
  }

  function formatDate(iso) {
    if (!iso) return '';
    return iso.slice(0, 10);
  }

  function renderGrid(photos) {
    photoGrid.innerHTML = '';
    countLabel.textContent = `${photos.length} photo${photos.length !== 1 ? 's' : ''}`;

    if (!photos.length) {
      showStatus('No photos match your filter.', 'empty');
      return;
    }

    clearStatus();

    photos.forEach(photo => {
      const card = document.createElement('div');
      card.className = 'photo-card';
      card.title = 'Click to copy URL';

      const loc  = photo.location_name || photo.caption || '';
      const date = formatDate(photo.taken_at);

      card.innerHTML = `
        <img src="${cloudinaryThumb(photo.image_url)}" loading="lazy" alt="${loc}" />
        <div class="photo-meta">
          ${loc ? `<div class="loc">${loc}</div>` : ''}
          ${date ? `<div class="date">${date}</div>` : ''}
        </div>
        <span class="copy-badge">Copied!</span>
      `;

      card.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(photo.image_url);
        } catch {
          // fallback
          const ta = document.createElement('textarea');
          ta.value = photo.image_url;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        }
        card.classList.add('copied');
        setTimeout(() => card.classList.remove('copied'), 1800);
        showToast('URL copied to clipboard');
      });

      photoGrid.appendChild(card);
    });
  }

  function applyFilters() {
    const q    = searchInput.value.trim().toLowerCase();
    const date = dateInput.value.trim();

    const filtered = allPhotos.filter(p => {
      if (date && !(p.taken_at || '').startsWith(date)) return false;
      if (q) {
        const haystack = `${p.location_name || ''} ${p.caption || ''}`.toLowerCase();
        if (!haystack.includes(q)) return false;
      }
      return true;
    });

    renderGrid(filtered);
  }

  async function loadPhotos() {
    showStatus('<span class="spin"></span> Loading photos from upload.nickward.co.uk…', 'loading');
    photoGrid.innerHTML = '';
    countLabel.textContent = '';

    try {
      const res  = await fetch(`${PHOTO_BASE}/api/gallery`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      allPhotos  = Array.isArray(data) ? data : (data.images || []);
      // Sort newest first
      allPhotos.sort((a, b) => (b.taken_at || '').localeCompare(a.taken_at || ''));
      clearStatus();
      applyFilters();
    } catch (err) {
      showStatus(`Failed to load photos: ${err.message}`, 'error');
      countLabel.textContent = '';
    }
  }

  searchInput.addEventListener('input', applyFilters);
  dateInput.addEventListener('input', applyFilters);
  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    dateInput.value   = '';
    applyFilters();
  });

  loadPhotos();
})();
</script>
</body>
</html>

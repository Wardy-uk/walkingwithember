---
// Variant B of the homepage A/B test. Never linked or indexed — the
// ab-home edge function rewrites "/" here for the B cohort, so visitors
// see this content at "/" and never at this URL.
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeSections from "../components/HomeSections.astro";
import { getRegions, getSiteSettings } from "../lib/content";

const settings = await getSiteSettings();
const regions = await getRegions();
---

<BaseLayout
  title={`${settings.siteName} | UK Hillwalking with a Dog`}
  description="UK hillwalking and mountain routes, trail notes, and honest hill days out with Ember."
  regions={regions}
  siteName={settings.siteName}
  tagline={settings.tagline}
  canonicalPath="/"
  noindex={true}
>
  <HomeSections variant="b" />
</BaseLayout>
